# common config
PUID: 1000
PGID: 1000
TZ: America/Chicago

# proton config for gluetun
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_ADDRESS=10.2.0.2/32
#SERVER_COUNTRIES=United States
#SERVER_CITIES=Chicago
PORT_FORWARD_ONLY=on

# optional
HTTPPROXY=off
SHADOWSOCKS=off
DOT=off
DNS_ADDRESS=10.2.0.1

# port fowarding
DOCKER_MODS=ghcr.io/t-anc/gsp-qbittorent-gluetun-sync-port-mod:main
#VPN_PORT_FORWARDING=on
#VPN_PORT_FORWARDING_PROVIDER=protonvpn
#VPN_PORT_FORWARDING_UP_COMMAND=/bin/sh -c 'wget -O- --retry-connrefused --post-data "json={\"listen_port\":{{PORT}},\"current_network_interface\":\"{{VPN_INTERFACE}}\",\"random_port\":false,\"upnp\":false}" http://127.0.0.1:8090/api/v2/app/setPreferences 2>&1'
#VPN_PORT_FORWARDING_DOWN_COMMAND=/bin/sh -c 'wget -O- --retry-connrefused --post-data "json={\"listen_port\":0,\"current_network_interface\":\"lo\"}" http://127.0.0.1:8090/api/v2/app/setPreferences 2>&1'

# gluetun specific
UPDATER_PERIOD=0
WIREGUARD_IMPLEMENTATION=auto

# notes
# TCP 8090=qBittorrent Web UI
# TCP 8091=qBittorrent Web UI w/ OAuth
# TCP 5030=Soulseek Web UI
# TCP 50300=Soulseek Service Port
# TCP 9823=VPN Speedtest Port
