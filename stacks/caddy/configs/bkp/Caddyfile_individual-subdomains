## common site config
(common) {
	# limit access to LAN & VPNs only
	#@denied not client_ip private_ranges 192.168.20.0/24 10.10.10.0/24 100.100.0.0/16
	# limit access to LAN & VPNs only
	#abort @denied

	# enable websockets
	#@websockets {
	#header Connection *Upgrade*
	#header Upgrade websocket
	#}

	# configure DNS
	tls {
		dns cloudflare REDACTED
		resolvers 1.1.1.1:53
		propagation_timeout 15m

		# tuning
		dns_challenge_override_domain _acme-challenge.samskeyti.net

		# primary issuer
		#issuer zerossl REDACTED

		# fallback
		#issuer letsencrypt
	}

	# compress contents
	encode zstd gzip

	# log user access
	# log {
	# 	output file /data/logs/access.log
	# 	format console
	# }

	# harden proxy, etc.
	header {
		# forward real IP
		X-Real-IP {http.request.remote}

		# enable HSTS
		Strict-Transport-Security "max-age=31536000; includeSubdomains"

		# disable clients from sniffing the media type
		X-Content-Type-Options nosniff

		# clickjacking protection
		X-Frame-Options DENY

		# keep referrer data off of HTTP connections
		Referrer-Policy no-referrer-when-downgrade

		# Content-Security-Policy: default-src 'self'
	}
}

