## proxmox
# proxmox @ kex (P510)
kex.samskeyti.net {
	import common
	reverse_proxy https://192.168.20.42:8006 {
		transport http {
			tls_insecure_skip_verify

			# SNI
			tls_server_name kex.samskeyti.net
		}

		# webauthn fix
		header_up Host kex.samskeyti.net
		header_up Connection {>Connection}
		header_up Upgrade {>Upgrade}
	}

	# fix embedded shell issues (note: insecure, so keep this local/VPN-only)
	header -X-Frame-Options
	header -Content-Security-Policy
}

