# common config
TZ=America/Chicago
PUID=1000
PGID=1000

# gluetun
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard # change as per wiki 
WIREGUARD_ADDRESSES=10.2.0.2/32 # IP V4 Only - remove if using openvpn
HTTPPROXY=off # change to on if you wish to enable
SHADOWSOCKS=off # change to on if you wish to enable
VPN_PORT_FORWARDING=on
VPN_PORT_FORWARDING_PROVIDER=protonvpn
UPDATER_PERIOD=24h

# notes
# TCP 8090=qBittorrent Web UI
# TCP 8091=qBittorrent Web UI w/ OAuth
# TCP 5030=Soulseek Web UI
# TCP 50300=Soulseek Service Port
# TCP 9823=VPN Speedtest Port
